# Copy to .env (git-ignored) and fill in.
# ADS token: https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=
# Claude API key, unless you use an `ant auth login` profile. Max/Team plans include
# monthly API credits: claude.ai Settings > Billing > API credits, then create a key at
# https://platform.claude.com. Keep it here, not exported in your shell profile.
ANTHROPIC_API_KEY=
# Optional contact string added to the User-Agent sent to ADS and arXiv. An email address in it is
# also sent to Unpaywall, unless UNPAYWALL_EMAIL gives another.
LITREVIEW_CONTACT=
# Optional: your email address, for Unpaywall, which finds legal open-access copies of papers by DOI
# and asks for an address with every request. Unpaywall isn't used without this or an address in
# LITREVIEW_CONTACT.
UNPAYWALL_EMAIL=
